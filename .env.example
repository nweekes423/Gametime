# Django Settings
SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SSL Settings (Optional for local development if using runserver)
SSL_CERTIFICATE=
SSL_PRIVATE_KEY=

# Celery / Redis Settings
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Twilio (leave unset to use fake SMS mode locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_FAKE_MODE=True

# Database Settings (Defaults to sqlite3)
# DATABASE_URL=sqlite:///db.sqlite3
